rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Customer profile photos
    match /customer_photos/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Partner profile photos
    match /partner_photos/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Partner verification documents (strictly restricted to owner and Super Admin)
    match /partner_docs/{partnerId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == partnerId || isSuperAdmin());
      allow write: if isAuthenticated() && request.auth.uid == partnerId
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Salon showcase photos
    match /salon_photos/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Home promotional sliders
    match /home_sliders/{sliderId}/{fileName} {
      allow read: if true;
      allow write: if (isAuthenticated() || isSuperAdmin())
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // Featured Services (Super Admin managed)
    match /featured_services/{serviceId}/{fileName} {
      allow read: if true;
      allow write: if (isAuthenticated() || isSuperAdmin())
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // Salon-specific Services (Partner managed)
    match /salon_services/{salonId}/{serviceId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && (
          isSuperAdmin() ||
          firestore.get(/databases/(default)/documents/salons/$(salonId)).data.partnerId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/salons/$(salonId)).data.ownerId == request.auth.uid
        )
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated()
        && (
          isSuperAdmin() ||
          firestore.get(/databases/(default)/documents/salons/$(salonId)).data.partnerId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/salons/$(salonId)).data.ownerId == request.auth.uid
        );
    }

    // Fallback rule
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}

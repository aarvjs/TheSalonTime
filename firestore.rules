rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validGender(data) {
      return !('gender' in data)
        || data.gender in [
          'Male',
          'Female',
          'Man',
          'Woman',
          'Other',
          'Prefer not to say',
          ''
        ];
    }

    function validProfile(data) {
      return validGender(data)
        && (
          !('displayName' in data)
          || (
            data.displayName is string
            && data.displayName.size() <= 60
          )
        )
        && (
          !('photoUrl' in data)
          || data.photoUrl == null
          || data.photoUrl is string
        )
        && (
          !('profileCompleted' in data)
          || data.profileCompleted is bool
        )
        && (
          !('latitude' in data)
          || (
            data.latitude is number
            && data.latitude >= -90
            && data.latitude <= 90
          )
        )
        && (
          !('longitude' in data)
          || (
            data.longitude is number
            && data.longitude >= -180
            && data.longitude <= 180
          )
        )
        && (
          !('locationPermissionStatus' in data)
          || data.locationPermissionStatus in [
            'granted',
            'denied',
            'deniedForever',
            'unknown'
          ]
        );
    }

    // CUSTOMER PROFILES
    match /customers/{uid} {

      // Users can get their own profile (or other authenticated users for bookings)
      allow get: if signedIn();

      // Prevent listing/dumping all customer profiles
      allow list: if false;

      // Create a profile only for the authenticated user
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'displayName',
          'gender',
          'photoUrl',
          'profileCompleted',
          'createdAt',
          'updatedAt',
          'latitude',
          'longitude',
          'locationUpdatedAt',
          'locationPermissionStatus'
        ])
        && request.resource.data.uid == uid
        && validProfile(request.resource.data);

      // Update permitted profile fields only
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'displayName',
          'gender',
          'photoUrl',
          'profileCompleted',
          'createdAt',
          'updatedAt',
          'latitude',
          'longitude',
          'locationUpdatedAt',
          'locationPermissionStatus'
        ])
        && request.resource.data.uid == uid
        // Immutable security fields: uid, phoneNumber and createdAt cannot be altered
        && (!('phoneNumber' in resource.data) || request.resource.data.phoneNumber == resource.data.phoneNumber)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        // Disallow touching immutable keys
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt'])
        // Permitted update fields only
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'gender',
          'phoneNumber',
          'photoUrl',
          'profileCompleted',
          'updatedAt',
          'latitude',
          'longitude',
          'locationUpdatedAt',
          'locationPermissionStatus'
        ])
        && validProfile(request.resource.data);

      // Customer documents cannot be deleted from the client
      allow delete: if false;
    }

    function validPartnerProfile(data) {
      return (
          !('fullName' in data)
          || (data.fullName is string && data.fullName.size() <= 100)
        )
        && (
          !('phoneNumber' in data)
          || (data.phoneNumber is string && data.phoneNumber.size() <= 25)
        )
        && (
          !('email' in data)
          || (data.email is string && data.email.size() <= 100)
        )
        && (
          !('businessName' in data)
          || (data.businessName is string && data.businessName.size() <= 150)
        )
        && (
          !('role' in data)
          || data.role == 'partner'
        )
        && (
          !('profilePhoto' in data)
          || data.profilePhoto == null
          || data.profilePhoto is string
        )
        && (
          !('verificationStatus' in data)
          || data.verificationStatus in [
            'not_submitted',
            'submitted',
            'pending',
            'underReview',
            'under_review',
            'approved',
            'rejected',
            'needsInfo',
            'needs_info'
          ]
        )
        && (
          !('legalName' in data)
          || (data.legalName is string && data.legalName.size() <= 150)
        )
        && (
          !('businessType' in data)
          || (data.businessType is string && data.businessType.size() <= 100)
        )
        && (
          !('regNumber' in data)
          || (data.regNumber is string && data.regNumber.size() <= 100)
        )
        && (
          !('businessAddress' in data)
          || (data.businessAddress is string && data.businessAddress.size() <= 500)
        )
        && (
          !('documents' in data)
          || data.documents is list
        );
    }

    // PARTNER PROFILES
    match /partners/{partnerId} {

      // Partners can only read their own private profile
      allow get: if isOwner(partnerId);

      // Prevent bulk export / listing of all partner documents
      allow list: if false;

      // Create new partner profile upon registration
      allow create: if isOwner(partnerId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'phoneNumber',
          'email',
          'businessName',
          'role',
          'verificationStatus',
          'profilePhoto',
          'legalName',
          'businessType',
          'regNumber',
          'businessAddress',
          'rejectionReason',
          'submittedAt',
          'documents',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == partnerId
        && request.resource.data.role == 'partner'
        // Newly registered partners start strictly with not_submitted or submitted/pending
        && request.resource.data.verificationStatus in ['not_submitted', 'submitted', 'pending']
        && validPartnerProfile(request.resource.data);

      // Update permitted fields only
      allow update: if isOwner(partnerId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'phoneNumber',
          'email',
          'businessName',
          'role',
          'verificationStatus',
          'profilePhoto',
          'legalName',
          'businessType',
          'regNumber',
          'businessAddress',
          'rejectionReason',
          'submittedAt',
          'documents',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == partnerId
        // Immutable security fields cannot be changed by the client:
        && (!('phoneNumber' in resource.data) || request.resource.data.phoneNumber == resource.data.phoneNumber)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        // Disallow modifying protected security keys
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'phoneNumber',
          'createdAt',
          'role'
        ])
        // Ordinary users can NEVER approve their own account:
        && request.resource.data.verificationStatus != 'approved'
        // Only permitted fields may be updated by client
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'businessName',
          'profilePhoto',
          'legalName',
          'businessType',
          'regNumber',
          'businessAddress',
          'documents',
          'verificationStatus',
          'submittedAt',
          'updatedAt'
        ])
        && validPartnerProfile(request.resource.data);

      // Partner documents cannot be deleted from the client
      allow delete: if false;
    }

    match /salons/{salonId} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}

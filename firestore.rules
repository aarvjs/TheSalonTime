rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    function validGender(data) {
      return !('gender' in data)
        || data.gender in [
          'Male',
          'Female',
          'Man',
          'Woman',
          'Other',
          'Prefer not to say',
          ''
        ];
    }

    function validProfile(data) {
      return validGender(data)
        && (
          !('displayName' in data)
          || (
            data.displayName is string
            && data.displayName.size() <= 60
          )
        )
        && (
          !('photoUrl' in data)
          || data.photoUrl == null
          || data.photoUrl is string
        )
        && (
          !('profileCompleted' in data)
          || data.profileCompleted is bool
        )
        && (
          !('latitude' in data)
          || (
            data.latitude is number
            && data.latitude >= -90
            && data.latitude <= 90
          )
        )
        && (
          !('longitude' in data)
          || (
            data.longitude is number
            && data.longitude >= -180
            && data.longitude <= 180
          )
        )
        && (
          !('locationPermissionStatus' in data)
          || data.locationPermissionStatus in [
            'granted',
            'denied',
            'deniedForever',
            'unknown'
          ]
        );
    }

    // CUSTOMER PROFILES
    match /customers/{uid} {

      // Users can get their own profile (or other authenticated users for bookings)
      allow get: if signedIn();

      // Only super admins can list all customer profiles
      allow list: if isSuperAdmin();

      // Create a profile only for the authenticated user
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'displayName',
          'gender',
          'photoUrl',
          'profileCompleted',
          'createdAt',
          'updatedAt',
          'latitude',
          'longitude',
          'locationUpdatedAt',
          'locationPermissionStatus'
        ])
        && request.resource.data.uid == uid
        && validProfile(request.resource.data);

      // Update permitted profile fields only
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'displayName',
          'gender',
          'photoUrl',
          'profileCompleted',
          'createdAt',
          'updatedAt',
          'latitude',
          'longitude',
          'locationUpdatedAt',
          'locationPermissionStatus'
        ])
        && request.resource.data.uid == uid
        // Immutable security fields: uid, phoneNumber and createdAt cannot be altered
        && (!('phoneNumber' in resource.data) || request.resource.data.phoneNumber == resource.data.phoneNumber)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        // Disallow touching immutable keys
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt'])
        // Permitted update fields only
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'gender',
          'phoneNumber',
          'photoUrl',
          'profileCompleted',
          'updatedAt',
          'latitude',
          'longitude',
          'locationUpdatedAt',
          'locationPermissionStatus'
        ])
        && validProfile(request.resource.data);

      // Customer documents cannot be deleted from the client
      allow delete: if false;
    }

    function validPartnerProfile(data) {
      return (
          !('fullName' in data)
          || (data.fullName is string && data.fullName.size() <= 100)
        )
        && (
          !('phoneNumber' in data)
          || (data.phoneNumber is string && data.phoneNumber.size() <= 25)
        )
        && (
          !('email' in data)
          || (data.email is string && data.email.size() <= 100)
        )
        && (
          !('businessName' in data)
          || (data.businessName is string && data.businessName.size() <= 150)
        )
        && (
          !('role' in data)
          || data.role == 'partner'
        )
        && (
          !('profilePhoto' in data)
          || data.profilePhoto == null
          || data.profilePhoto is string
        )
        && (
          !('businessModel' in data)
          || data.businessModel in ['salon', 'homeService', 'home_service', 'both']
        )
        && (
          !('activeBusinessModel' in data)
          || data.activeBusinessModel in ['salon', 'homeService', 'home_service', 'both']
        )
        && (
          !('verificationStatus' in data)
          || data.verificationStatus in [
            'not_submitted',
            'submitted',
            'pending',
            'underReview',
            'under_review',
            'approved',
            'rejected',
            'needsInfo',
            'needs_info'
          ]
        )
        && (
          !('legalName' in data)
          || (data.legalName is string && data.legalName.size() <= 150)
        )
        && (
          !('businessType' in data)
          || (data.businessType is string && data.businessType.size() <= 100)
        )
        && (
          !('regNumber' in data)
          || (data.regNumber is string && data.regNumber.size() <= 100)
        )
        && (
          !('businessAddress' in data)
          || (data.businessAddress is string && data.businessAddress.size() <= 500)
        )
        && (
          !('documents' in data)
          || data.documents is list
        );
    }

    // PARTNER PROFILES
    match /partners/{partnerId} {

      // Partners can read their own profile, or verified super admin can view
      allow get: if isOwner(partnerId) || isSuperAdmin();

      // Only verified super admins can list all partners
      allow list: if isSuperAdmin();

      // Create new partner profile upon registration
      allow create: if isOwner(partnerId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'phoneNumber',
          'email',
          'businessName',
          'role',
          'verificationStatus',
          'businessModel',
          'activeBusinessModel',
          'profilePhoto',
          'legalName',
          'businessType',
          'regNumber',
          'businessAddress',
          'rejectionReason',
          'submittedAt',
          'documents',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == partnerId
        && request.resource.data.role == 'partner'
        // Newly registered partners start strictly with not_submitted or submitted/pending
        && request.resource.data.verificationStatus in ['not_submitted', 'submitted', 'pending']
        && validPartnerProfile(request.resource.data);

      // Update permitted fields only (or super admin reviewing/approving)
      allow update: if isSuperAdmin() || (
        isOwner(partnerId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'phoneNumber',
          'email',
          'businessName',
          'role',
          'verificationStatus',
          'businessModel',
          'activeBusinessModel',
          'profilePhoto',
          'legalName',
          'businessType',
          'regNumber',
          'businessAddress',
          'rejectionReason',
          'submittedAt',
          'documents',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == partnerId
        // Immutable security fields cannot be changed by the client:
        && (!('phoneNumber' in resource.data) || request.resource.data.phoneNumber == resource.data.phoneNumber)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        // Disallow modifying protected security keys
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'phoneNumber',
          'createdAt',
          'role'
        ])
        // Ordinary users can NEVER approve their own account or modify reviewer notes:
        && request.resource.data.verificationStatus in ['not_submitted', 'submitted', 'pending']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt'])
        // Only permitted fields may be updated by client
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'businessName',
          'profilePhoto',
          'legalName',
          'businessType',
          'regNumber',
          'businessAddress',
          'documents',
          'businessModel',
          'activeBusinessModel',
          'verificationStatus',
          'submittedAt',
          'updatedAt'
        ])
        && validPartnerProfile(request.resource.data)
      );

      // Partner documents cannot be deleted from the client
      allow delete: if false;
    }

    // UNIFIED SALON LOCATIONS
    match /salons/{salonId} {
      // Anyone can read and update salon locations
      allow read, write: if true;
    }

    // MULTIPLE SALON BRANCHES (BACKWARD COMPATIBILITY MIRROR)
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // HOME SERVICE PROFILES
    match /home_service_profiles/{partnerId} {
      allow read, write: if true;
    }

    // BRANCH MANAGERS
    match /branch_managers/{managerId} {
      // Manager themselves, appointing partner, super admin, or guest can read/write
      allow read, write: if true;
    }

    // APPOINTMENTS / BOOKINGS
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // SYSTEM SETUP & INITIALIZATION LOCK (ONE-TIME PROVISIONING)
    match /system/admin_setup {
      // Anyone can check if super admin setup is completed
      allow get: if true;
      allow list: if false;

      // Allowed to create ONLY ONCE by the first authenticated user during initial setup
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/admin_setup)
        && request.resource.data.superAdminUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'super_admin'
        && request.resource.data.keys().hasOnly(['superAdminUid', 'email', 'role', 'initializedAt']);

      // Permanently immutable: cannot be modified or deleted by anyone from client
      allow update, delete: if false;
    }

    function validAdminProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'department',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == request.auth.uid
        && data.role == 'super_admin'
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && (!('department' in data) || (data.department is string && data.department.size() <= 100))
        && (!('status' in data) || data.status in ['active', 'inactive', 'suspended']);
    }

    // SUPER ADMIN PROFILES
    match /admins/{adminId} {
      // An admin can read their own profile, or any verified super admin can view
      allow get: if signedIn() && (request.auth.uid == adminId || isSuperAdmin());

      // Only verified super admins can list admins
      allow list: if signedIn() && isSuperAdmin();

      // Initial one-time registration:
      // Allowed ONLY IF system/admin_setup did not exist before and is created in the same atomic transaction for this user
      allow create: if signedIn()
        && request.auth.uid == adminId
        && !exists(/databases/$(database)/documents/system/admin_setup)
        && getAfter(/databases/$(database)/documents/system/admin_setup).data.superAdminUid == adminId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'super_admin'
        && validAdminProfile(request.resource.data);

      // Super admin can update their profile (name, department, updatedAt)
      // but CANNOT modify uid, role, or createdAt
      allow update: if signedIn()
        && request.auth.uid == adminId
        && isSuperAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'createdAt'])
        && validAdminProfile(request.resource.data);

      // Super admins cannot be deleted from client SDK
      allow delete: if false;
    }
  }
}
